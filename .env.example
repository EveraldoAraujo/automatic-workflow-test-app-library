# API configuration (copy to .env for local use).
# The API loads `.env` on start via dotenv (see loadEnvFile() in apps/api/src/config.ts);
# .env is git-ignored. Values already present in the process env take precedence.

PORT=3000
NODE_ENV=development
# Comma-separated CORS allowlist. "*" is ignored when NODE_ENV=production.
CORS_ORIGINS=http://localhost:4200

# Web (production builds only): optional runtime override for the API base URL.
# Set globalThis.__API_BASE_URL__ in the hosting shell, or edit the default in
# apps/web/src/environments/environment.production.ts and rebuild.
# API_BASE_URL=https://api.example.com/api
