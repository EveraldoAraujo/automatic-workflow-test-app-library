# API configuration (copy to .env for local use).
# The API reads these directly from the environment; .env is git-ignored.

PORT=3000
NODE_ENV=development
# Comma-separated CORS allowlist. "*" is ignored when NODE_ENV=production.
CORS_ORIGINS=http://localhost:4200

# Web (production builds only): optional runtime override for the API base URL.
# Set globalThis.__API_BASE_URL__ in the hosting shell, or adjust the
# productionApiBaseUrl fallback in apps/web/src/environments/environment.production.ts.
# API_BASE_URL=https://api.example.com/api
