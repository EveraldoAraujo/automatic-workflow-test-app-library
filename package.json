{
  "name": "mono",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @mono/api\" \"npm run dev -w @mono/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
