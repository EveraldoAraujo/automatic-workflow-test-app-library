{
  "name": "mono",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "npm run build -w @mono/shared",
    "build:shared": "npm run build -w @mono/shared",
    "prebuild": "npm run build:shared",
    "build": "npm run build -w @mono/api && npm run build -w @mono/web",
    "pretest": "npm run build:shared",
    "test": "npm run test --workspaces --if-present",
    "prelint": "npm run build:shared",
    "lint": "npm run lint --workspaces --if-present",
    "predev": "npm run build:shared",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @mono/api\" \"npm run dev -w @mono/web\""
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
